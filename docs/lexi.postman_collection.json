{
  "info": {
    "name": "Lexi — Webhook Assíncrono (PoC)",
    "description": "Coleção de exemplos pra testar a PoC manualmente. Importável no Postman, Insomnia ou Bruno. Suba o servidor antes (npm run dev) — padrão em http://localhost:3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "1. Webhook — envio",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"messageId\": \"msg-sucesso-001\",\n  \"from\": \"+5511999998888\",\n  \"message\": \"Quero negociar minha dívida\",\n  \"timestamp\": \"2026-08-16T12:00:00Z\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/webhook", "host": ["{{baseUrl}}"], "path": ["webhook"] }
      }
    },
    {
      "name": "2. Webhook — falha forçada (retry esgota, cai na DLQ)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          {
            "key": "x-force-llm-outcome",
            "value": "fail",
            "description": "Força as 3 tentativas a falharem e dispara o outbound de fallback + DLQ — sem isso, a chance de falha real 3x seguidas é só ~0,3%."
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"messageId\": \"msg-falha-001\",\n  \"from\": \"+5511999998888\",\n  \"message\": \"Quero negociar minha dívida\",\n  \"timestamp\": \"2026-08-16T12:00:00Z\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/webhook", "host": ["{{baseUrl}}"], "path": ["webhook"] }
      }
    },
    {
      "name": "3. Webhook — payload inválido (400)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"from\": \"+5511999998888\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/webhook", "host": ["{{baseUrl}}"], "path": ["webhook"] }
      }
    },
    {
      "name": "4. Ver chamadas de saída registradas",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/outbound-calls", "host": ["{{baseUrl}}"], "path": ["outbound-calls"] }
      }
    },
    {
      "name": "5. Ver itens na Dead Letter Queue",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/dead-letters", "host": ["{{baseUrl}}"], "path": ["dead-letters"] }
      }
    }
  ]
}
